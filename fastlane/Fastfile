require "securerandom"

default_platform(:ios)

platform :ios do
  desc "Generate/fetch all Match profiles (development + appstore)"
  lane :match_all do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )
    match(type: "development", api_key: api_key)
    match(type: "appstore", api_key: api_key)
  end

  desc "Fetch existing Match profiles (read-only, for CI/onboarding)"
  lane :match_readonly do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )
    match(type: "development", api_key: api_key, readonly: true)
    match(type: "appstore", api_key: api_key, readonly: true)
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    tag = ENV.fetch("GIT_TAG") { `git describe --tags --exact-match 2>/dev/null`.strip }
    UI.user_error!("GIT_TAG not set and HEAD is not tagged") if tag.empty?
    UI.message("Deploying tag: #{tag}")

    version = tag.sub(%r{^beta/}, "")
    UI.message("Marketing version: #{version}")

    changelog = `git tag -l --format='%(contents)' #{tag}`.strip
    changelog = "Beta build #{tag}" if changelog.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    ci_keychain = nil
    if ENV["CI"]
      ci_keychain = "fastlane_ci"
      keychain_password = SecureRandom.hex(16)
      create_keychain(
        name: ci_keychain,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600
      )
      match(
        type: "appstore",
        api_key: api_key,
        readonly: true,
        keychain_name: ci_keychain,
        keychain_password: keychain_password
      )
    else
      match(type: "appstore", api_key: api_key, readonly: true)
    end

    build_number = latest_testflight_build_number(api_key: api_key) + 1
    UI.message("Build number: #{build_number}")

    build_app(
      project: "VOEMonitor.xcodeproj",
      scheme: "VOEMonitorIOS",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.github.yefimtsev.VOEMonitor.iOS" => "match AppStore com.github.yefimtsev.VOEMonitor.iOS",
          "com.github.yefimtsev.VOEMonitor.iOS.Widget" => "match AppStore com.github.yefimtsev.VOEMonitor.iOS.Widget"
        }
      },
      xcargs: "MARKETING_VERSION='#{version}' CURRENT_PROJECT_VERSION='#{build_number}'",
      output_directory: "build",
      derived_data_path: "build/DerivedData",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      changelog: changelog,
      skip_waiting_for_build_processing: true
    )

    UI.success("#{tag} (#{version} build #{build_number}) uploaded to TestFlight!")
  ensure
    delete_keychain(name: ci_keychain) if ci_keychain
  end
end
